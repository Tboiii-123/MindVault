# Copy to .env (dev) or .env.prod (production). Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres container (prod compose only)
POSTGRES_USER=ainotes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ainotes
DATABASE_URL=postgres://ainotes:ainotes@localhost:5432/ainotes
REDIS_URL=redis://localhost:6379/0

# Object storage for audio (USE_S3=1 -> S3 / MinIO / R2)
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# AI providers: fake (offline, free) by default. Switch to OpenAI by uncommenting.
# AI_STT_PROVIDER=apps.ai.providers.openai_provider.OpenAISTTProvider
# AI_LLM_PROVIDER=apps.ai.providers.openai_provider.OpenAILLMProvider
# OPENAI_API_KEY=sk-...

# Production only
# SECURE_SSL_REDIRECT=1
# CSRF_TRUSTED_ORIGINS=https://api.example.com
